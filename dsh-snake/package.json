{
  "name": "@jsun969/dsh-snake",
  "version": "1.5.0",
  "description": "Snake game plugin for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsun969/dsh-snake-game.git",
    "directory": "dsh-snake"
  },
  "publishConfig": { "access": "public" },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
